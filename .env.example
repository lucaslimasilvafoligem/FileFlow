# Docker images
MINIO_IMAGE=minio/minio:latest
POSTGRES_IMAGE=postgres:16-alpine
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine

# MinIO
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
MINIO_API_PORT=9000
MINIO_API_INTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_INTERNAL_PORT=9001
MINIO_HEALTH_INTERVAL=10s
MINIO_HEALTH_TIMEOUT=5s
MINIO_HEALTH_RETRIES=5
MINIO_HEALTH_START_PERIOD=10s

# PostgreSQL
POSTGRES_DB=fileflow
POSTGRES_USER=fileflow
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432
POSTGRES_HEALTH_INTERVAL=10s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=5
POSTGRES_HEALTH_START_PERIOD=10s

# RabbitMQ
QUEUE_USER=fileflow
QUEUE_PASSWORD=change_me
QUEUE_PORT=5672
QUEUE_INTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_INTERNAL_PORT=15672
QUEUE_HEALTH_INTERVAL=15s
QUEUE_HEALTH_TIMEOUT=10s
QUEUE_HEALTH_RETRIES=5
QUEUE_HEALTH_START_PERIOD=30s

# General
RESTART_POLICY=unless-stopped